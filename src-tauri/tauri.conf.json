{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskTest Pro",
  "version": "1.0.0",
  "identifier": "br.com.iacomputers.disktestpro",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "DiskTest Pro - Diagnostico de Discos",
        "width": 1020,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/smartctl"
    ]
  }
}
